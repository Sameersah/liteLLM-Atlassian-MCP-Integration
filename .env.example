# LiteLLM Proxy (copy to .env and fill; never commit .env)
OPENAI_API_KEY=sk-your-openai-api-key
LITELLM_MASTER_KEY=sk-your-litellm-master-key

# Atlassian OAuth 2.0 (3LO) – for config.yaml MCP OAuth (Option 1 / PKCE)
# Create app at https://developer.atlassian.com/console/myapps/
# Callback URL in Atlassian app: http://localhost:4000/callback
ATLASSIAN_OAUTH_CLIENT_ID=your_atlassian_oauth_client_id
ATLASSIAN_OAUTH_CLIENT_SECRET=your_atlassian_oauth_client_secret
